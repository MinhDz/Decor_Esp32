    )
    (net NET_LEFT
      (pins SW_LEFT-2 SW_LEFT-2@1 R_LEFT-1)
    )
    (net NET_UP
      (pins SW_UP-2 SW_UP-2@1 R_UP-1)
    )
    (net NET_MENU
      (pins R_MENU-1 SW_MENU-2 SW_MENU-2@1)
    )

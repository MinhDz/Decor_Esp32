    )
    (class kicad_default +3V3 +5V BAT_ADC CHG_STAT GND KEY_ADC MH_KEY NET_DOWN
      NET_EXIT NET_LED_A NET_LEFT NET_MENU NET_RIGHT NET_UP VBAT VIN_5V VOUT_5V
      (circuit

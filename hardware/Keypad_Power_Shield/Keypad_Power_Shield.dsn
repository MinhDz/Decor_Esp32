    )
    (net NET_DOWN
      (pins SW_DOWN-2 SW_DOWN-2@1 R_DOWN-1)
    )
    (net +3V3
      (pins R_PU-1 J_ESP-2)
    )
    (net VIN_5V
      (pins J_MHCD42-1 R_CHG1-1)
    )
    (net VOUT_5V
      (pins J_MHCD42-4 SW_PWR-1)
    )
    (net MH_KEY
      (pins J_MHCD42-6)
    )
    (net BAT_ADC
      (pins C_BAT-1 J_ESP-6 R_BAT1-2 R_BAT2-1)
    )
    (net NET_RIGHT
